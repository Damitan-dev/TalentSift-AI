# OpenAI API key used only by the TalentSift backend.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Optional.
#
# Leave unset locally to use:
# data/
#
# In deployment, point this to a persistent mounted disk.
TALENTSIFT_DATA_DIR=data

# Optional live candidate preview; final transcription remains separate.
TALENTSIFT_LIVE_CAPTIONS=1
TALENTSIFT_CAPTION_DELAY=low
TALENTSIFT_NOISE_PROFILE=near_field
